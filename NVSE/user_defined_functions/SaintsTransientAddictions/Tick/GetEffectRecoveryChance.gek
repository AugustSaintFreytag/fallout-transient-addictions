begin function { float fDependence }

	; Config

	float fRecoveryMinHealth = GetINIFloat_Cached "Recovery:fRecoveryMinHealth" "SaintsTransientAddictions.ini"
	float fRecoveryDependencePivot = GetINIFloat_Cached "Recovery:fRecoveryDependencePivot" "SaintsTransientAddictions.ini"
	float fRecoveryEnduranceFactor = GetINIFloat_Cached "Recovery:fRecoveryEnduranceFactor" "SaintsTransientAddictions.ini"
	float fRecoveryLuckFactor = GetINIFloat_Cached "Recovery:fRecoveryLuckFactor" "SaintsTransientAddictions.ini"

	; Main

	float fHealthChanceFactor = 0.0
	float fPlayerHealthFraction = Player.GetAV Health / Player.GetBaseAV Health

	if fPlayerHealthFraction > fRecoveryMinHealth
		let fHealthChanceFactor := 1.0
	endif

	float fDependenceChanceFactor = (GetMaxOf 0.0 (1 - (fDependence / fRecoveryDependencePivot)))
	float fEnduranceBaseChance = ((Player.GetAV Endurance) / 9) * fRecoveryEnduranceFactor
	float fLuckBaseChance = ((Player.GetAV Luck) / 9) * fRecoveryLuckFactor
	float fBaseChance = fEnduranceBaseChance + fLuckBaseChance
	float fFinalChance = (GetMinOf (fBaseChance * fDependenceChanceFactor * fHealthChanceFactor) 1.0)

	SetFunctionValue fFinalChance

end
