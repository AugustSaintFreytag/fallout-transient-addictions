begin function { ref rItem }

	; Dependence Map

	array_var aDependenceByAddictionType = Player.AuxStringMapArrayGetAsArray "STAd_DependenceByAddictionType"

	; Addiction

	ref rAddictionType = GetAddictionEffect rItem
	string_var sAddictionTypeId = RefToString rAddictionType

	float fDependence = 0

	if eval (Ar_HasKey aDependenceByAddictionType, sAddictionTypeId)
		let fDependence := aDependenceByAddictionType[$sAddictionTypeId]
	endif

	; Return

	SetFunctionValue fDependence

	; Clean-Up

	Sv_Destruct sAddictionTypeId

	let aDependenceByAddictionType := Ar_Null

end
