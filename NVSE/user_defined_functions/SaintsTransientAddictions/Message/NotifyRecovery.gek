begin function { string_var sItemName }

	; UDFs

	ref ShowRecoveryMessageUDF = CompileScript "SaintsTransientAddictions\Message\ShowRecoveryMessage.gek"
	ref ShowRecoveryMessageBoxUDF = CompileScript "SaintsTransientAddictions\Message\ShowRecoveryMessageBox.gek"
	ref PlayRecoverySoundUDF = CompileScript "SaintsTransientAddictions\Message\PlayRecoverySound.gek"

	; Config

	short iRecoveryMessageMode = GetINIFloat_Cached "Recovery:iRecoveryMessageMode" "SaintsTransientAddictions.ini"

	; Main

	if iRecoveryMessageMode == 0
		return
	endif

	Call PlayRecoverySoundUDF

	if iRecoveryMessageMode == 2
		Call ShowRecoveryMessageUDF sItemName
	endif

	if iRecoveryMessageMode == 3
		Call ShowRecoveryMessageBoxUDF sItemName
	endif

end
