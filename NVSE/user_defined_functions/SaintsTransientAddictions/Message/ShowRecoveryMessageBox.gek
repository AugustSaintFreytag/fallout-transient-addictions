begin function { string_var sItemName }

	; UDFs

	ref GetRecoveryMessagesUDF = CompileScript "SaintsTransientAddictions\Message\GetRecoveryMessages.gek"

	; Config

	array_var aMessages = (Call GetRecoveryMessagesUDF)
	short iNumMessages = Ar_Size aMessages

	; Selection

	short iLastMessageIndex = Player.AuxiliaryVariableGetFloat "*STAd_RecoveryMessageLastIndex"
	short iRandomMessageIndex = Rand 0 (iNumMessages - 1)

	if iRandomMessageIndex == iLastMessageIndex
		let iRandomMessageIndex := (iRandomMessageIndex + 1) % iNumMessages
	endif

	Player.AuxiliaryVariableSetFloat "*STAd_RecoveryMessageLastIndex" iRandomMessageIndex

	; Presentation

	string_var sMessage = aMessages[iRandomMessageIndex]

	;PrintC "[STA] Selected recovery message at index %g with contents '%z'." iRandomMessageIndex sMessage

	MessageBoxEx ($sMessage) sItemName

	; Clean-Up

	Sv_Destruct sItemName, sMessage

	let aMessages := Ar_Null

end
