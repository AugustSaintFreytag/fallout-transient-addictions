begin function { ref rItem }

	; UDFs

	ref GetDependenceForItemUDF = CompileScript "SaintsTransientAddictions\Dependence\GetDependenceForItem.gek"
	ref SetDependenceForItemUDF = CompileScript "SaintsTransientAddictions\Dependence\SetDependenceForItem.gek"

	; Main

	if GetSelfAlt != Player
		return
	endif

	array_var aBaseAddictionChanceByItem = Player.AuxStringMapArrayGetAsArray "*STAd_BaseAddictionChanceByItem"
	string_var sItemId = GetFormIDString rItem

	if eval !(Ar_HasKey aBaseAddictionChanceByItem, sItemId)
		Sv_Destruct sItemId
		let aBaseAddictionChanceByItem := Ar_Null
		return
	endif

	float fDependencePerUse = GetINIFloat_Cached "Addiction:fDependencePerUse" "SaintsTransientAddictions.ini"
	float fDependence = (Call GetDependenceForItemUDF rItem) + fDependencePerUse

	Call SetDependenceForItemUDF rItem fDependence

	; Restore immediately after engine has processed item use.

	float fBaseAddictionChance = aBaseAddictionChanceByItem[sItemId]
	SetAddictionChance rItem fBaseAddictionChance

	; Debug

	short bDebug = GetINIFloat_Cached "Debug:bDebug" "SaintsTransientAddictions.ini"

	if bDebug
		PrintC "[STA] Player activated item '%n' (%z), dependence has increased to: %.4f." rItem sItemId fDependence
	endif

	; Clean-Up

	Sv_Destruct sItemId

	let aBaseAddictionChanceByItem := Ar_Null

end
